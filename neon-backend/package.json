{
  "name": "hangouthub-neon-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "cd ../frontend && npm ci && npm run build",
    "embed": "node scripts/embed-frontend.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build:frontend && npm run embed && npm run typecheck && neon deploy --env .env.local"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.21",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
